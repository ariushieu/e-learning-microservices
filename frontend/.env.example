# Chép thành .env.local khi chạy `pnpm dev` trên máy.

# Địa chỉ gateway nhìn từ server Next.js (không phải từ trình duyệt).
# Chạy backend bằng Docker hoặc IntelliJ trên cùng máy: http://localhost:8080
# Trong docker compose: http://api-gateway:8080 (đã khai sẵn trong docker-compose.yml)
GATEWAY_URL=http://localhost:8080

# Bật khi web chạy sau HTTPS. Để false khi chạy http://localhost, nếu không trình duyệt bỏ cookie.
COOKIE_SECURE=false
