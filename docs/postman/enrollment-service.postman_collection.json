{
  "info": {
    "description": "API chuẩn hóa. Điền email, password, courseId, lessonId rồi đăng nhập. Khóa học phải PUBLISHED và snapshot đã đồng bộ. Các thư mục hoàn thành/hủy/xóa chạy riêng theo trạng thái; không chạy cả collection mù quáng. Xem enrollment-service/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "name": "HUNRE - Enrollment API qua Gateway"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "courseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "lessonId",
      "value": "",
      "type": "string"
    },
    {
      "key": "enrollmentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "item": [
        {
          "name": "Đăng nhập và lưu JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.accessToken).to.be.a('string');",
                  "pm.collectionVariables.set('accessToken', data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "name": "1. Đăng nhập học viên"
    },
    {
      "item": [
        {
          "name": "Ghi danh khóa PUBLISHED (hoặc kích hoạt lại lượt đã hủy)",
          "request": {
            "method": "POST",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "url": "{{baseUrl}}/api/enrollments",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\"courseId\":{{courseId}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.status).to.eql('ACTIVE');",
                  "pm.collectionVariables.set('enrollmentId', String(data.id));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Danh sách của người đang đăng nhập",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/enrollments?page=0&size=10&sort=enrolledAt,desc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Chi tiết lượt ghi danh",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/enrollments/{{enrollmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Ghi danh trùng bị chặn",
          "request": {
            "method": "POST",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "url": "{{baseUrl}}/api/enrollments",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\"courseId\":{{courseId}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "name": "2. Ghi danh và đọc dữ liệu"
    },
    {
      "item": [
        {
          "name": "Hoàn thành bài học; lặp với từng lessonId trong khóa",
          "request": {
            "method": "PUT",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "url": "{{baseUrl}}/api/lessons/{{lessonId}}/progress",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\"courseId\":{{courseId}},\"status\":\"COMPLETED\",\"watchedSeconds\":300}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.lessonId).to.eql(Number(pm.collectionVariables.get('lessonId')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Xem tiến độ khóa học",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/progress?courseId={{courseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "name": "3. Tiến độ (lessonId phải thuộc courseId)"
    },
    {
      "item": [
        {
          "name": "Xem chứng chỉ",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/enrollments/{{enrollmentId}}/certificate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "name": "4. Chứng chỉ (chỉ chạy sau khi hoàn thành tất cả bài học)"
    },
    {
      "item": [
        {
          "name": "Không token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/enrollments",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Thiếu courseId",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/progress"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "courseId sai kiểu",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/progress?courseId=abc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Sắp xếp theo trường không tồn tại",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/enrollments?sort=doesNotExist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Không được tự đánh dấu COMPLETED",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "url": "{{baseUrl}}/api/enrollments/{{enrollmentId}}/status",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\"status\":\"COMPLETED\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 422', () => pm.response.to.have.status(422));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Trạng thái không hợp lệ",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "url": "{{baseUrl}}/api/enrollments/{{enrollmentId}}/status",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\"status\":\"UNKNOWN\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Số giây xem âm",
          "request": {
            "method": "PUT",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "url": "{{baseUrl}}/api/lessons/{{lessonId}}/progress",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\"courseId\":{{courseId}},\"status\":\"IN_PROGRESS\",\"watchedSeconds\":-1}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "name": "5. Kiểm tra đầu vào và xác thực"
    },
    {
      "item": [
        {
          "name": "Hủy lượt ghi danh",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "value": "application/json",
                "key": "Content-Type"
              }
            ],
            "url": "{{baseUrl}}/api/enrollments/{{enrollmentId}}/status",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\"status\":\"CANCELLED\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.status).to.eql('CANCELLED');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "name": "6. Hủy ghi danh (chạy riêng khi lượt ghi danh chưa COMPLETED)"
    },
    {
      "item": [
        {
          "name": "Xóa ghi danh, tiến độ và chứng chỉ của khóa đã chọn",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/enrollments?courseId={{courseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ],
      "name": "7. XÓA dữ liệu học của chính tài khoản đang dùng (chỉ chạy khi muốn đặt lại)"
    }
  ]
}
