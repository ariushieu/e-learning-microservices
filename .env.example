# Sao chép file này thành .env (đã được gitignore) và đổi mật khẩu nếu cần.
# docker compose tự đọc .env; không có .env thì dùng giá trị mặc định trong docker-compose.yml.
# Nếu đổi MYSQL_USER, sửa luôn tên user trong infra/mysql/init/01-create-databases.sql.

MYSQL_ROOT_PASSWORD=root
MYSQL_USER=elearning
MYSQL_PASSWORD=elearning

# Khóa ký JWT. PHẢI giống nhau ở cả 5 service lẫn api-gateway, nếu không thì
# auth-service ký ra token mà service khác không đọc được.
# Tối thiểu 32 ký tự. Khi triển khai thật hãy thay bằng chuỗi ngẫu nhiên:
#   openssl rand -base64 48
JWT_SECRET=elearning-microservices-auth-service-jwt-secret-key-for-local-dev-only-32bytes
