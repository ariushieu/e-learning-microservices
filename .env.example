# Sao chép file này thành .env (đã được gitignore) và đổi mật khẩu nếu cần.
# docker compose tự đọc .env; không có .env thì dùng giá trị mặc định trong docker-compose.yml.
# Nếu đổi MYSQL_USER, sửa luôn tên user trong infra/mysql/init/01-create-databases.sql.

MYSQL_ROOT_PASSWORD=root
MYSQL_USER=elearning
MYSQL_PASSWORD=elearning
