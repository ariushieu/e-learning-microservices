<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hunre</groupId>
        <artifactId>e-learning-microservices</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shared-common</artifactId>
    <name>shared-common</name>
    <description>Thư viện dùng chung: DTO, exception, tiện ích</description>

    <!--
        Module này là thư viện (JAR thường) được các service import,
        nên KHÔNG có class main và KHÔNG dùng spring-boot-maven-plugin.
    -->
    <dependencies>
        <!--
            optional = không lan truyền sang module nào import shared-common.

            Lý do: api-gateway chạy WebFlux. Nếu spring-boot-starter-webmvc theo shared-common
            chui vào classpath của gateway thì Spring Boot thấy có cả servlet lẫn reactive và
            chọn servlet, gateway hỏng hoàn toàn. Cả 5 service đều đã tự khai webmvc trong pom
            của mình nên không mất gì, còn gateway thì chỉ lấy đúng phần không phụ thuộc web
            (JwtVerifier, ErrorResponse).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Kiểm chữ ký JWT. Cùng thư viện và cùng phiên bản với auth-service (bên ký token)
            để không gặp khác biệt khi đọc claim. Phiên bản khai ở pom cha.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
