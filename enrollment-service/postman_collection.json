                  "    pm.expect(json.code).to.eql(\"VALIDATION_FAILED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/enrollments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "enrollments"]
            },
            "description": "Gửi request thiếu trường courseId bắt buộc."
