    {
      "name": "📚 2. Kiểm thử Bắt lỗi & Ràng buộc nghiệp vụ (Validation & Business Rules)",
      "description": "Kiểm tra hệ thống xử lý lỗi chuẩn theo chuẩn REST: 409 Duplicate, 400 Validation Error, 404 Not Found.",
      "item": [
        {
          "name": "1. Bắt lỗi Đăng ký trùng lặp (Duplicate Resource - HTTP 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status là 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Mã lỗi DUPLICATE_RESOURCE\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "    pm.expect(json.code).to.eql(\"DUPLICATE_RESOURCE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{testCourseId}},\n  \"userId\": {{demoUserId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/enrollments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "enrollments"]
            },
            "description": "Cố tình ghi danh lại khóa học đã đăng ký để kiểm tra phản hồi 409 Conflict."
          }
        },
        {
          "name": "2. Bắt lỗi Thiếu trường bắt buộc (Validation Error - HTTP 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP Status là 400 Bad Request\", function () {",
