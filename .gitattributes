/mvnw text eol=lf
*.cmd text eol=crlf

# Script chạy trên Linux, có CR ở cuối dòng là lỗi "bad interpreter"
*.sh text eol=lf

# Git hook không có đuôi .sh nên phải chỉ định riêng. Thiếu dòng này thì máy Windows
# clone về sẽ nhận file CRLF và hook hỏng ngay từ dòng shebang.
.githooks/* text eol=lf

# Flyway tính checksum theo nội dung file, khác kiểu xuống dòng giữa các máy
# sẽ làm migration đã chạy bị báo checksum mismatch
*.sql text eol=lf

# Docker đọc hai file này trong container Linux. CRLF ở cuối dòng "RUN ... \" làm lệnh nối
# dòng hỏng, và mẫu trong .dockerignore dính "\r" sẽ không khớp với file nào.
Dockerfile    text eol=lf
.dockerignore text eol=lf
